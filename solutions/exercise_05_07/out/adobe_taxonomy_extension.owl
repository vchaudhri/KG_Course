    <owl:Class rdf:about="http://example.org/genus-kg#c15_leadership_transition_cfo_departure_ceo_search">
        <rdfs:comment>arises_from: changes in key executive personnel, such as CFO departure or CEO search</rdfs:comment>
        <rdfs:label>c15 leadership transition cfo departure ceo search</rdfs:label>
        <originalMention>Leadership transition (CFO departure / CEO search)</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#firm_specific_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c18_competitive_risk_from_ai_ad_platform_ecosystem_players">
        <rdfs:comment>arises_from: competitive actions by AI and ad-platform ecosystem players impacting pricing power and market share</rdfs:comment>
        <rdfs:label>c18 competitive risk from ai ad platform ecosystem players</rdfs:label>
        <originalMention>Competitive risk from AI/ad-platform ecosystem players</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#firm_specific_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c19_ip_copyright_commercial_safety_concerns_around_ai">
        <rdfs:comment>arises_from: intellectual property and commercial safety concerns regarding the training and usage of artificial intelligence models</rdfs:comment>
        <rdfs:label>c19 ip copyright commercial safety concerns around ai</rdfs:label>
        <originalMention>IP / copyright &amp; commercial-safety concerns around AI</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#firm_specific_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c20_seasonal_calendar_effects_holiday_back_to_school_cyber_monday_shift">
        <rdfs:comment>arises_from: recurring calendar patterns affecting demand and sales timing</rdfs:comment>
        <rdfs:label>c20 seasonal calendar effects holiday back to school cyber monday shift</rdfs:label>
        <originalMention>Seasonal &amp; calendar effects (holiday, back-to-school, Cyber Monday shift)</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#systematic_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c21_emerging_markets_demand_strength">
        <rdfs:comment>impacts: sales and customer acquisition due to strong demand in emerging markets</rdfs:comment>
        <rdfs:label>c21 emerging markets demand strength</rdfs:label>
        <originalMention>Emerging markets demand strength</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#economic_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c22_investment_spend_cost_pressure_on_margins_ai_infrastructure_marketing_events">
        <rdfs:comment>arises_from: investment in AI infrastructure and marketing/events, creating pressure on margins</rdfs:comment>
        <rdfs:label>c22 investment spend cost pressure on margins ai infrastructure marketing events</rdfs:label>
        <originalMention>Investment spend &amp; cost pressure on margins (AI infrastructure, marketing/events)</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#expense"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c23_share_repurchase_capital_allocation">
        <rdfs:comment>expected_to_generate: increased earnings per share for remaining shareholders by reducing outstanding shares</rdfs:comment>
        <rdfs:label>c23 share repurchase capital allocation</rdfs:label>
        <originalMention>Share repurchase / capital allocation</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#investment"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c24_analyst_concern_growth_deceleration_guidance_optics">
        <rdfs:comment>consequently_impacts: investor perception of future growth and guidance credibility</rdfs:comment>
        <rdfs:label>c24 analyst concern growth deceleration guidance optics</rdfs:label>
        <originalMention>Analyst concern: growth deceleration / guidance optics</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#firm_specific_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c25_reporting_business_mix_reclassification_effects">
        <rdfs:comment>affects: the categorization and recognition of financial metrics due to internal business model transitions or reclassification between reporting segments</rdfs:comment>
        <rdfs:label>c25 reporting business mix reclassification effects</rdfs:label>
        <originalMention>Reporting / business-mix reclassification effects</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#reporting_effect"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c26_execution_arr_to_revenue_linearity">
        <rdfs:comment>impacts: the consistency and efficiency of converting Annual Recurring Revenue (ARR) into recognized revenue within a given quarter</rdfs:comment>
        <rdfs:label>c26 execution arr to revenue linearity</rdfs:label>
        <originalMention>Execution: ARR-to-revenue linearity</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#revenue"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c27_rise_of_llm_agentic_search_generative_engine_optimization_geo_opportunity">
        <rdfs:comment>arises_from: the widespread adoption of LLM-driven discovery and agentic search, creating new opportunities for content and experience management</rdfs:comment>
        <rdfs:label>c27 rise of llm agentic search generative engine optimization geo opportunity</rdfs:label>
        <originalMention>Rise of LLM/agentic search &amp; generative-engine-optimization (GEO) opportunity</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#systematic_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#c28_debate_ai_s_net_effect_on_adobe_s_addressable_market_pricing_model">
        <rdfs:comment>arises_from: speculation regarding generative AI's potential to alter Adobe's addressable market and pricing model</rdfs:comment>
        <rdfs:label>c28 debate ai s net effect on adobe s addressable market pricing model</rdfs:label>
        <originalMention>Debate: AI's net effect on Adobe's addressable market &amp; pricing model</originalMention>
        <rdfs:subClassOf rdf:resource="http://example.org/genus-kg#firm_specific_risk"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#reporting_effect">
        <rdfs:comment>NEW GENUS -- This concept describes internal company decisions or transitions (like business model changes or reclassifications) that primarily affect how financial results (e.g., revenue, ARR) are categorized, recognized, or presented, often leading to discrepancies between reported metrics and underlying business trends. It is distinct from external risks or direct income/expense items.</rdfs:comment>
        <rdfs:label>reporting effect</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/genus-kg#strategic_tradeoff">
        <rdfs:comment>NEW GENUS -- Neither the risk branch (externally imposed uncertainty) nor the income/return branch (realized value creation) captures a deliberate, company-controlled exchange of one value driver for another -- trading near-term ARR for long-term MAU/funnel growth. Modeled as a sibling genus to risk and income directly under thing -- deliberately not under a more specific shared ancestor like the former 'metric' class, since that class isn't guaranteed to exist under the same name across re-exports of the taxonomy, while 'thing' always does.</rdfs:comment>
        <rdfs:label>strategic tradeoff</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>

</rdf:RDF>